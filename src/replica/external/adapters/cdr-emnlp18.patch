+def _dv_values(y, dv):
+    """Response values for a possibly transformed DV such as ``log(fdur)``.
+
+    predict.py derives ``dv`` by string-slicing the formula, so a transform
+    stays in the name and ``y[dv]`` raises. Evaluate the expression instead.
+    """
+    if dv in y.columns:
+        return y[dv]
+    return y.eval(dv, engine='python', local_dict={'log': np.log,
+                                                   'log1p': np.log1p,
+                                                   'sqrt': np.sqrt})
+
